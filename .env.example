# Copy this file to .env and fill in what you have. Everything is optional:
# with no keys at all the app still makes videos (offline scripts + local backgrounds).

# --- Gemini (free tier) : product analysis from photos + script writing ---
# Get a key at https://aistudio.google.com/apikey  (Google account, no credit card)
GEMINI_API_KEY=
# Model name; check the current free models at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest
# Used when the main model is overloaded (503)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.1-flash-lite
# Optional: Gemini image model for backgrounds (often NOT in the free tier). Empty = disabled.
GEMINI_IMAGE_MODEL=

# --- Background image providers, tried in order. "procedural" (local) is always last. ---
# pollinations = free, no key. gemini_image = needs GEMINI_IMAGE_MODEL.
BG_PROVIDERS=pollinations,procedural
POLLINATIONS_URL=https://image.pollinations.ai/prompt/{prompt}
POLLINATIONS_MODEL=flux
# Optional token from https://auth.pollinations.ai (higher limits). Empty = anonymous.
POLLINATIONS_TOKEN=

# --- Your own daily call limits (0 = no limit). The app never assumes a provider's quota. ---
GEMINI_DAILY_LIMIT=0
GEMINI_IMAGE_DAILY_LIMIT=0
POLLINATIONS_DAILY_LIMIT=0

# --- AI product photos (re-created in new scenes/angles) via free Hugging Face Spaces ---
# Works without an account (small daily GPU quota). A FREE token gives more: https://huggingface.co/settings/tokens (Read)
HF_TOKEN=
HF_EDIT_SPACES=black-forest-labs/FLUX.1-Kontext-Dev,multimodalart/Qwen-Image-Edit-Fast
# Different AI photos per video (each ~20-40s of free GPU); other scenes reuse them with new camera motion
AI_IMAGES_PER_VIDEO=3
HF_EDIT_DAILY_LIMIT=0
HF_KONTEXT_STEPS=28
AI_REF_SIZE=1280
# Gemini compares each AI photo with the real product; score < AI_VERIFY_MIN (0-10) -> redo AI_RETRIES times
AI_VERIFY=1
GEMINI_VERIFY_MODEL=gemini-flash-lite-latest
AI_VERIFY_MIN=7
AI_RETRIES=1
# Optional sharper upscale: path to realesrgan-ncnn-vulkan.exe (https://github.com/xinntao/Real-ESRGAN/releases)
REALESRGAN_PATH=

# ---- Paid Pollinations (pollen). Used ONLY when you pick "AI Pro" / "Chuyển động AI" in the render form.
# Key: https://enter.pollinations.ai/keys (sk_...). Put it in POLLINATIONS_TOKEN above.
# nanobanana2 (~0.08/ảnh, chính xác nhất) | seedream (0.03) | seedream-pro (0.042) | kontext (0.03)
POLLINATIONS_EDIT_MODEL=nanobanana2
POLLINATIONS_PRO_DAILY_LIMIT=0
# 1 = also use the key for composite-mode backgrounds (flux, ~0.002 pollen/image)
POLLINATIONS_BG_USE_KEY=0
# Scenes per video that get a real AI motion clip (rest = FFmpeg motion)
AI_MOTION_SCENES=2

# --- Voices: gtts = Google voice (free, no key, female only); edge_tts = male voice NamMinh ---
# gemini_tts uses GEMINI_API_KEY (free tier). Female = Leda; set GEMINI_TTS_MALE (e.g. Charon) to use Gemini for male too.
TTS_PROVIDERS=gemini_tts,gtts,edge_tts
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_FEMALE=Leda
GEMINI_TTS_MALE=
GEMINI_TTS_DAILY_LIMIT=0
VOICE_FEMALE=vi-VN-HoaiMyNeural
VOICE_MALE=vi-VN-NamMinhNeural

# --- Paths (auto-detected; set only if detection fails) ---
# FFMPEG_PATH=D:\tools\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=D:\tools\ffmpeg\bin\ffprobe.exe
# FONT_PATH=C:\Windows\Fonts\arialbd.ttf
# DATA_DIR=D:\aff-tiktok-data

# Background removal model: isnet-general-use (best, ~180MB) | u2net (~170MB) | u2netp (small, 4MB, lower quality)
# Sharper cutouts (composite mode): birefnet-general-lite (~200MB) or birefnet-general (~900MB), downloaded once
REMBG_MODEL=isnet-general-use
# Photos where a hand holds the product: SAM separates product from hand (~100MB download on first use).
# Leave empty to show such photos as a framed card instead.
REMBG_HAND_MODEL=sam
# x264 preset for scene clips: ultrafast | veryfast | medium
RENDER_PRESET=veryfast
